# secrets
.env
# dependencies & build output
node_modules/
engine/out/
# per-video heavy files (regenerated by tools/pipeline.sh; raw recordings live on Drive)
videos/*/source/raw/*
!videos/*/source/raw/README.md
videos/*/source/*.mp4
videos/*/source/*.txt
videos/*/audio/vo/
videos/*/audio/music/
videos/*/audio/mix/*.wav
videos/*/exports/
# account screenshots, downloaded documents and voice notes stay local (not needed to rebuild a video)
videos/*/source/explore/
videos/*/source/payslip/
videos/*/source/*.aac
videos/*/source/*.m4a
engine/public/*/
!engine/public/brand/
.DS_Store
